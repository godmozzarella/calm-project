# Шаблон env-переменных для бэка Calm.
# Скопируй в .env и заполни реальными значениями: `cp .env.example .env`

# ── Email-провайдер ──
# smtp (Spring JavaMailSender) или resend (HTTP API resend.com).
# Для российских домашних/офисных сетей выбирай resend — SMTP часто блочится.
CALM_MAIL_PROVIDER=resend

# ── Resend (CALM_MAIL_PROVIDER=resend) ──
# https://resend.com/api-keys — 100 писем/день, 3000/месяц бесплатно.
# До верификации домена отправка возможна только с onboarding@resend.dev
# и только на email аккаунта Resend.
CALM_RESEND_API_KEY=
CALM_MAIL_FROM=onboarding@resend.dev
CALM_MAIL_FROM_NAME=Calm

# ── SMTP (CALM_MAIL_PROVIDER=smtp) ──
# Для Gmail: CALM_SMTP_HOST=smtp.gmail.com, CALM_SMTP_PORT=587, CALM_MAIL_FROM=тот-же-адрес
# Включи двухэтапную проверку и создай пароль приложения; обычный пароль аккаунта не используй.
# Для Яндекс.Почты: хост smtp.yandex.ru, порт 587 и отдельный пароль приложения.
CALM_SMTP_HOST=smtp.gmail.com
CALM_SMTP_PORT=587
CALM_SMTP_USER=
CALM_SMTP_PASS=
CALM_SMTP_DEBUG=false

# ── JWT ──
CALM_JWT_SECRET=
CALM_PUBLIC_URL=http://localhost

# ── CORS ──
CALM_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
