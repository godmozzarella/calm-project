# Copy values into backend/.env.training-worker (ignored by Git, mode 600).
# Use four separate MongoDB users as described in README-mongo-auth-migration.md.
CALM_TRAINING_SOURCE_URI=mongodb://calm_risk_export_reader:REPLACE_WITH_URL_ENCODED_PASSWORD@mongo:27017/calm?authSource=admin
CALM_TRAINING_MONGO_URI=mongodb://calm_risk_training_writer:REPLACE_WITH_URL_ENCODED_PASSWORD@mongo:27017/calm_risk_training?authSource=admin
CALM_TRAINING_HMAC_KEY=REPLACE_WITH_STABLE_SECRET_OF_AT_LEAST_32_BYTES
CALM_RISK_CONSENT_VERSION=REPLACE_AFTER_APPROVING_CONSENT_TEXT
CALM_RISK_CONSENT_DIGEST=REPLACE_WITH_64_CHARACTER_SHA256_FROM_PARTICIPATION_API
