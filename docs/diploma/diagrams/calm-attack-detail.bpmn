        <di:waypoint x="1340" y="560" />
        <di:waypoint x="1340" y="660" />
        <di:waypoint x="1210" y="660" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1280" y="610" width="45" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a13" bpmnElement="a13">
        <di:waypoint x="960" y="660" />
        <di:waypoint x="636" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a14" bpmnElement="a14">
        <di:waypoint x="960" y="540" />
        <di:waypoint x="870" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a15" bpmnElement="a15">
        <di:waypoint x="620" y="540" />
        <di:waypoint x="436" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_assoc_fields" bpmnElement="assoc_fields">
        <di:waypoint x="1725" y="278" />
        <di:waypoint x="1725" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_assoc_more" bpmnElement="assoc_more">
        <di:waypoint x="2065" y="358" />
        <di:waypoint x="2065" y="805" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_assoc_rules" bpmnElement="assoc_rules">
        <di:waypoint x="2060" y="580" />
        <di:waypoint x="2060" y="740" />
        <di:waypoint x="1250" y="740" />
        <di:waypoint x="1250" y="815" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>