        <dc:Bounds x="1130" y="170" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_merge" bpmnElement="merge" isMarkerVisible="true">
        <dc:Bounds x="1480" y="298" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_pain" bpmnElement="pain">
        <dc:Bounds x="1600" y="278" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_symptoms" bpmnElement="symptoms">
        <dc:Bounds x="1940" y="278" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_note" bpmnElement="note">
        <dc:Bounds x="2280" y="278" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_submit" bpmnElement="submit">
        <dc:Bounds x="2280" y="500" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_validate" bpmnElement="validate">
        <dc:Bounds x="1940" y="500" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_valid" bpmnElement="valid" isMarkerVisible="true">
        <dc:Bounds x="1800" y="520" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1740" y="460" width="160" height="50" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_error" bpmnElement="error">
        <dc:Bounds x="1480" y="620" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_save" bpmnElement="save">
        <dc:Bounds x="1480" y="500" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_saved" bpmnElement="saved" isMarkerVisible="true">
        <dc:Bounds x="1320" y="520" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1260" y="460" width="160" height="50" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_saveerror" bpmnElement="saveerror">
        <dc:Bounds x="960" y="620" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_update" bpmnElement="update">
        <dc:Bounds x="960" y="500" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_show" bpmnElement="show">
        <dc:Bounds x="620" y="500" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_finish" bpmnElement="finish">
        <dc:Bounds x="400" y="522" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="335" y="565" width="166" height="48" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_failedEnd" bpmnElement="failedEnd">
        <dc:Bounds x="600" y="642" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="535" y="685" width="166" height="48" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_fields" bpmnElement="fields">
        <dc:Bounds x="1580" y="110" width="365" height="95" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_more" bpmnElement="more">
        <dc:Bounds x="2020" y="805" width="590" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_rules" bpmnElement="rules">
        <dc:Bounds x="960" y="815" width="600" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_a1" bpmnElement="a1">
        <di:waypoint x="136" y="318" />
        <di:waypoint x="215" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a2" bpmnElement="a2">
        <di:waypoint x="255" y="318" />
        <di:waypoint x="320" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a3" bpmnElement="a3">
        <di:waypoint x="570" y="318" />
        <di:waypoint x="650" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a4" bpmnElement="a4">
        <di:waypoint x="900" y="318" />
        <di:waypoint x="1000" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_completed" bpmnElement="completed">
        <di:waypoint x="1020" y="298" />
        <di:waypoint x="1020" y="210" />
        <di:waypoint x="1130" y="210" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1050" y="195" width="120" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_ongoing" bpmnElement="ongoing">
        <di:waypoint x="1040" y="318" />
        <di:waypoint x="1480" y="318" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1190" y="290" width="160" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a5" bpmnElement="a5">
        <di:waypoint x="1380" y="210" />
        <di:waypoint x="1500" y="210" />
        <di:waypoint x="1500" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a6" bpmnElement="a6">
        <di:waypoint x="1520" y="318" />
        <di:waypoint x="1600" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a7" bpmnElement="a7">
        <di:waypoint x="1850" y="318" />
        <di:waypoint x="1940" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a8" bpmnElement="a8">
        <di:waypoint x="2190" y="318" />
        <di:waypoint x="2280" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a9" bpmnElement="a9">
        <di:waypoint x="2405" y="358" />
        <di:waypoint x="2405" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a10" bpmnElement="a10">
        <di:waypoint x="2280" y="540" />
        <di:waypoint x="2190" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a11" bpmnElement="a11">
        <di:waypoint x="1940" y="540" />
        <di:waypoint x="1840" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_good" bpmnElement="good">
        <di:waypoint x="1800" y="540" />
        <di:waypoint x="1730" y="540" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1750" y="510" width="40" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_invalid" bpmnElement="invalid">
        <di:waypoint x="1820" y="560" />
        <di:waypoint x="1820" y="660" />
        <di:waypoint x="1730" y="660" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1770" y="610" width="40" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_retry" bpmnElement="retry">
        <di:waypoint x="1480" y="660" />
        <di:waypoint x="235" y="660" />
        <di:waypoint x="235" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_a12" bpmnElement="a12">
        <di:waypoint x="1480" y="540" />
        <di:waypoint x="1360" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_saveok" bpmnElement="saveok">
        <di:waypoint x="1320" y="540" />
        <di:waypoint x="1210" y="540" />
        <bpmndi:BPMNLabel>
