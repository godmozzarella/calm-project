<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AttackDetail" targetNamespace="https://calmprj.ru/bpmn" exporter="Calm diploma" exporterVersion="1">
  <bpmn:process id="Process_AttackDetail" name="Calm — запись приступа" isExecutable="false">
    <bpmn:startEvent id="start" name="Пользователь решил записать приступ">
      <bpmn:outgoing>a1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="join" name="" gatewayDirection="Converging">
      <bpmn:incoming>a1</bpmn:incoming>
      <bpmn:incoming>retry</bpmn:incoming>
      <bpmn:outgoing>a2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="time" name="Указать дату и время начала">
      <bpmn:incoming>a2</bpmn:incoming>
      <bpmn:outgoing>a3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="active" name="Указать, продолжается ли приступ">
      <bpmn:incoming>a3</bpmn:incoming>
      <bpmn:outgoing>a4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gate" name="Приступ продолжается?" gatewayDirection="Diverging" default="ongoing">
      <bpmn:incoming>a4</bpmn:incoming>
      <bpmn:outgoing>completed</bpmn:outgoing>
      <bpmn:outgoing>ongoing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="endtime" name="Указать дату окончания и при наличии время">
      <bpmn:incoming>completed</bpmn:incoming>
      <bpmn:outgoing>a5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>ongoing</bpmn:incoming>
      <bpmn:incoming>a5</bpmn:incoming>
      <bpmn:outgoing>a6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="pain" name="Указать интенсивность и тип боли">
      <bpmn:incoming>a6</bpmn:incoming>
      <bpmn:outgoing>a7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="symptoms" name="Отметить симптомы и возможные триггеры">
      <bpmn:incoming>a7</bpmn:incoming>
      <bpmn:outgoing>a8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="note" name="Добавить заметку при необходимости">
      <bpmn:incoming>a8</bpmn:incoming>
      <bpmn:outgoing>a9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="submit" name="Сохранить приступ">
      <bpmn:incoming>a9</bpmn:incoming>
      <bpmn:outgoing>a10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="validate" name="Проверить данные приступа">
      <bpmn:incoming>a10</bpmn:incoming>
      <bpmn:outgoing>a11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="valid" name="Данные корректны?" gatewayDirection="Diverging" default="invalid">
      <bpmn:incoming>a11</bpmn:incoming>
      <bpmn:outgoing>good</bpmn:outgoing>
      <bpmn:outgoing>invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="error" name="Показать ошибку ввода">
      <bpmn:incoming>invalid</bpmn:incoming>
      <bpmn:outgoing>retry</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="save" name="Сохранить запись в дневнике">
      <bpmn:incoming>good</bpmn:incoming>
      <bpmn:outgoing>a12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="saved" name="Запись сохранена?" gatewayDirection="Diverging" default="failed">
      <bpmn:incoming>a12</bpmn:incoming>
      <bpmn:outgoing>saveok</bpmn:outgoing>
      <bpmn:outgoing>failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="saveerror" name="Показать ошибку сохранения">
      <bpmn:incoming>failed</bpmn:incoming>
      <bpmn:outgoing>a13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="update" name="Обновить состояние дневника и связанных исходов">
      <bpmn:incoming>saveok</bpmn:incoming>
      <bpmn:outgoing>a14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="show" name="Показать сохранённый приступ">
      <bpmn:incoming>a14</bpmn:incoming>
      <bpmn:outgoing>a15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="finish" name="Приступ записан">
      <bpmn:incoming>a15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="failedEnd" name="Запись не сохранена">
      <bpmn:incoming>a13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="a1" sourceRef="start" targetRef="join" />
    <bpmn:sequenceFlow id="a2" sourceRef="join" targetRef="time" />
    <bpmn:sequenceFlow id="a3" sourceRef="time" targetRef="active" />
    <bpmn:sequenceFlow id="a4" sourceRef="active" targetRef="gate" />
    <bpmn:sequenceFlow id="completed" sourceRef="gate" targetRef="endtime" name="Нет, завершён">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет, завершён</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ongoing" sourceRef="gate" targetRef="merge" name="Да, продолжается" />
    <bpmn:sequenceFlow id="a5" sourceRef="endtime" targetRef="merge" />
    <bpmn:sequenceFlow id="a6" sourceRef="merge" targetRef="pain" />
    <bpmn:sequenceFlow id="a7" sourceRef="pain" targetRef="symptoms" />
    <bpmn:sequenceFlow id="a8" sourceRef="symptoms" targetRef="note" />
    <bpmn:sequenceFlow id="a9" sourceRef="note" targetRef="submit" />
    <bpmn:sequenceFlow id="a10" sourceRef="submit" targetRef="validate" />
    <bpmn:sequenceFlow id="a11" sourceRef="validate" targetRef="valid" />
    <bpmn:sequenceFlow id="good" sourceRef="valid" targetRef="save" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="invalid" sourceRef="valid" targetRef="error" name="Нет" />
    <bpmn:sequenceFlow id="retry" sourceRef="error" targetRef="join" />
    <bpmn:sequenceFlow id="a12" sourceRef="save" targetRef="saved" />
    <bpmn:sequenceFlow id="saveok" sourceRef="saved" targetRef="update" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="failed" sourceRef="saved" targetRef="saveerror" name="Нет" />
    <bpmn:sequenceFlow id="a13" sourceRef="saveerror" targetRef="failedEnd" />
    <bpmn:sequenceFlow id="a14" sourceRef="update" targetRef="show" />
    <bpmn:sequenceFlow id="a15" sourceRef="show" targetRef="finish" />
    <bpmn:textAnnotation id="fields">
      <bpmn:text>Интенсивность 1–10; тип: пульсирующая, давящая, стреляющая, распирающая.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_fields" sourceRef="pain" targetRef="fields" />
    <bpmn:textAnnotation id="more">
      <bpmn:text>Симптомы и триггеры выбираются из справочников. Заметка необязательна; зоны боли редактируются отдельно после создания.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_more" sourceRef="symptoms" targetRef="more" />
    <bpmn:textAnnotation id="rules">
      <bpmn:text>Дата и время не в будущем; конец не раньше начала. При продолжающемся приступе дата окончания не сохраняется.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_rules" sourceRef="validate" targetRef="rules" />
  </bpmn:process>
  <bpmn:collaboration id="Collab_AttackDetail">
    <bpmn:participant id="Pool_AttackDetail" name="Calm" processRef="Process_AttackDetail" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_AttackDetail" name="Calm — запись приступа">
    <bpmndi:BPMNPlane id="Plane_AttackDetail" bpmnElement="Collab_AttackDetail">
      <bpmndi:BPMNShape id="shape_Pool_AttackDetail" bpmnElement="Pool_AttackDetail" isHorizontal="true">
        <dc:Bounds x="30" y="80" width="2770" height="1050" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="100" y="300" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="35" y="343" width="166" height="48" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_join" bpmnElement="join" isMarkerVisible="true">
        <dc:Bounds x="215" y="298" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_time" bpmnElement="time">
        <dc:Bounds x="320" y="278" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_active" bpmnElement="active">
        <dc:Bounds x="650" y="278" width="250" height="80" />
      </bpmndi:BPMNShape>
