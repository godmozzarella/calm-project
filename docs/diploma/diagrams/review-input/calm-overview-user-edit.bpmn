<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:storm="http://storm.bpmn2.ru/ns" id="Definitions_Calm" targetNamespace="https://calmprj.ru/bpmn" exporter="Calm overview generator" exporterVersion="1">
  <bpmn:process id="Process_Calm" name="Calm · общая схема процессов" isExecutable="false">
    <bpmn:documentation>Обзорная неисполняемая модель. «+» — свёрнутый подпроцесс. Внутри: действия участников, проверки, сохранение, отмена и обработка ошибок. Сплошная стрелка — последовательность; пунктир с кружком — сообщение внешнему участнику; X — выбор одной ветви. Ветви 1–7 возвращают к выбору действия; ветвь 8 завершает сеанс при успехе. Административные и фоновые запуски независимы. Дорожки разделяют группы процессов. Детальные роли и обмен с БД раскрываются ниже; VPS относится к развёртыванию. Схема описывает код проекта. Настройки запуска worker и доставки писем на VPS здесь не подтверждаются.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Calm" />
    <bpmn:startEvent id="Opened" name="Открытие приложения">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="NoAccess" name="Доступ не получен">
      <bpmn:incoming>F03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Choice" name="Выбранный сценарий" gatewayDirection="Diverging">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>SelectAttacks</bpmn:outgoing>
      <bpmn:outgoing>SelectMeds</bpmn:outgoing>
      <bpmn:outgoing>SelectDaily</bpmn:outgoing>
      <bpmn:outgoing>SelectRisk</bpmn:outgoing>
      <bpmn:outgoing>SelectStats</bpmn:outgoing>
      <bpmn:outgoing>SelectProfile</bpmn:outgoing>
      <bpmn:outgoing>SelectConsent</bpmn:outgoing>
      <bpmn:outgoing>SelectExit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Allowed" name="Доступ получен?" default="F03" storm:LabelWidth="84" storm:LabelHeight="12">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Access" name="Обеспечить доступ к системе">
      <bpmn:documentation>Проверка и обновление сессии; вход; регистрация с подтверждением почты; восстановление доступа. Ошибки ввода, повторная отправка кода и отмена раскрываются внутри подпроцесса.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Workspace" name="Подготовить рабочее пространство; выбрать действие">
      <bpmn:documentation>Первый вход: настройка профиля дневника и города с возможностью пропуска. Затем загрузка данных, календарь и выбор сценария. При повторном входе используются сохранённые настройки; опрос можно отложить.</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Result" name="Показать результат или состояние операции">
      <bpmn:documentation>Успех, отсутствие данных, отмена либо ошибка. Ошибка не представляется как успешное сохранение. Детальные проверки и повтор ввода находятся внутри выбранного подпроцесса.</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="F01" sourceRef="Opened" targetRef="Access" />
    <bpmn:sequenceFlow id="F03" name="Нет" sourceRef="Allowed" targetRef="NoAccess" storm:LabelWidth="19" storm:LabelHeight="12" />
    <bpmn:sequenceFlow id="F05" sourceRef="Workspace" targetRef="Choice" />
    <bpmn:sequenceFlow id="SelectAttacks" name="1" sourceRef="Choice" targetRef="Attacks">
      <bpmn:conditionExpression>Выбран сценарий 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SelectMeds" name="2" sourceRef="Choice" targetRef="Meds">
      <bpmn:conditionExpression>Выбран сценарий 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SelectDaily" name="3" sourceRef="Choice" targetRef="Daily">
      <bpmn:conditionExpression>Выбран сценарий 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SelectRisk" name="4" sourceRef="Choice" targetRef="Risk">
      <bpmn:conditionExpression>Выбран сценарий 4</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SelectStats" name="5" sourceRef="Choice" targetRef="Stats">
      <bpmn:conditionExpression>Выбран сценарий 5</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SelectProfile" name="6" sourceRef="Choice" targetRef="Profile">
      <bpmn:conditionExpression>Выбран сценарий 6</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SelectConsent" name="7" sourceRef="Choice" targetRef="Consent">
      <bpmn:conditionExpression>Выбран сценарий 7</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SelectExit" name="8" sourceRef="Choice" targetRef="Exit">
      <bpmn:conditionExpression>Выбран сценарий 8</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F08" sourceRef="Exit" targetRef="ExitGate" />
    <bpmn:sequenceFlow id="F10" name="Нет: отмена или ошибка" sourceRef="ExitGate" targetRef="Workspace" storm:LabelWidth="84" storm:LabelHeight="24" />
    <bpmn:sequenceFlow id="A01" sourceRef="AdminStart" targetRef="Role" />
    <bpmn:sequenceFlow id="A02" sourceRef="Role" targetRef="RoleGate" />
    <bpmn:sequenceFlow id="ReturnAttacks" sourceRef="Attacks" targetRef="Merge" />
    <bpmn:sequenceFlow id="ReturnMeds" sourceRef="Meds" targetRef="Merge" />
    <bpmn:sequenceFlow id="ReturnDaily" sourceRef="Daily" targetRef="Merge" />
    <bpmn:sequenceFlow id="ReturnRisk" sourceRef="Risk" targetRef="Merge" />
    <bpmn:sequenceFlow id="ReturnStats" sourceRef="Stats" targetRef="Merge" />
    <bpmn:sequenceFlow id="ReturnProfile" sourceRef="Profile" targetRef="Merge" />
    <bpmn:sequenceFlow id="ReturnConsent" sourceRef="Consent" targetRef="Merge" />
    <bpmn:sequenceFlow id="F06" sourceRef="Merge" targetRef="Result" />
    <bpmn:sequenceFlow id="F02" sourceRef="Access" targetRef="Allowed" />
    <bpmn:sequenceFlow id="F04" name="Да" sourceRef="Allowed" targetRef="Workspace" storm:LabelWidth="14" storm:LabelHeight="12" />
    <bpmn:sequenceFlow id="F07" name="Продолжить работу" sourceRef="Result" targetRef="Workspace" />
    <bpmn:endEvent id="AdminEnd" name="Результат операции">
      <bpmn:incoming>A04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="AdminWork" name="Управлять пользователями, справочниками, настройками и рассылками">
      <bpmn:documentation>Поиск и удаление пользователей, изменение ролей, ограничение участия в исследовании; справочники; настройки внешних данных и порога уведомлений; подтверждаемая email-рассылка. После действия администратор может начать следующий запрос.</bpmn:documentation>
      <bpmn:incoming>A03</bpmn:incoming>
      <bpmn:outgoing>A04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="RoleGate" name="" gatewayDirection="Diverging" default="A05">
      <bpmn:incoming>A02</bpmn:incoming>
      <bpmn:outgoing>A03</bpmn:outgoing>
      <bpmn:outgoing>A05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="AdminStart" name="Запрос администратора">
      <bpmn:outgoing>A01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="A06" sourceRef="Denied" targetRef="DeniedEnd" />
    <bpmn:sequenceFlow id="A04" sourceRef="AdminWork" targetRef="AdminEnd" />
    <bpmn:sequenceFlow id="A05" name="Нет прав" sourceRef="RoleGate" targetRef="Denied" storm:LabelWidth="45" storm:LabelHeight="12" />
    <bpmn:sequenceFlow id="A03" name="Разрешено" sourceRef="RoleGate" targetRef="AdminWork" />
    <bpmn:userTask id="Exit" name="Выйти из аккаунта или удалить аккаунт">
      <bpmn:documentation>Два альтернативных сценария: выход завершает сессию; подтверждённое удаление запускает удаление связанных данных приложения. Не подразумевает удаление ранее скачанных файлов или внешних резервных копий.</bpmn:documentation>
      <bpmn:incoming>SelectExit</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Consent" name="Управлять согласием на исследование">
      <bpmn:documentation>Просмотр условий, согласие при открытом наборе, отказ и отзыв согласия. Проверяются версия и содержание согласия, доступность набора и административные ограничения. Отказ не блокирует дневник.</bpmn:documentation>
      <bpmn:incoming>SelectConsent</bpmn:incoming>
      <bpmn:outgoing>ReturnConsent</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Profile" name="Изменить профиль и настройки">
      <bpmn:documentation>Имя, аватар, настройки дневника, местоположение и его режим, уведомления и оформление; смена пароля и почты с необходимыми подтверждениями. Управление аккаунтом не требует новой записи приступа.</bpmn:documentation>
      <bpmn:incoming>SelectProfile</bpmn:incoming>
      <bpmn:outgoing>ReturnProfile</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Stats" name="Просмотреть статистику и сформировать отчёт">
      <bpmn:documentation>Просмотр истории и статистики за период; частота и интенсивность приступов, симптомы, триггеры, зоны боли, препараты и оценки эффекта. Необязательные PDF, CSV и печать. Отчёты формируются клиентом из загруженных данных.</bpmn:documentation>
      <bpmn:incoming>SelectStats</bpmn:incoming>
      <bpmn:outgoing>ReturnStats</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Attacks" name="Вести дневник приступов">
      <bpmn:documentation>Создание, просмотр, изменение, завершение и удаление приступов; время, интенсивность, тип, симптомы, триггеры, зоны боли и заметки. Проверка владельца и данных. Устранение противоречащей отметки об отсутствии нового начала; уточнение исследовательских исходов.</bpmn:documentation>
      <bpmn:incoming>SelectAttacks</bpmn:incoming>
      <bpmn:outgoing>ReturnAttacks</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Risk" name="Получить погоду и оценку риска">
      <bpmn:documentation>Получение данных среды по городу; доступность и свежесть данных; резервные сохранённые данные. Действующий расчёт по правилам учитывает погоду и историю. Результат: балл, уровень, причины либо недоступность. Это не обученная модель и не подтверждённая вероятность. Опрос не является обязательным условием расчёта.</bpmn:documentation>
      <bpmn:incoming>SelectRisk</bpmn:incoming>
      <bpmn:outgoing>ReturnRisk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Daily" name="Вести ежедневные наблюдения">
      <bpmn:documentation>Опрос текущего дня, сон, стресс, новые начала приступов, препараты и алкоголь; условные вопросы о менструации и календарные отметки. Отдельно: подтверждение дня без НОВЫХ начал приступов и отмена подтверждения. Отсутствие записи не равно отрицательному исходу.</bpmn:documentation>
      <bpmn:incoming>SelectDaily</bpmn:incoming>
      <bpmn:outgoing>ReturnDaily</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Meds" name="Учитывать приём препаратов">
      <bpmn:documentation>Справочник и личные препараты; дозировка, время, связь с приступом при необходимости, оценка эффекта, изменение и удаление. Приём не обязателен после записи приступа.</bpmn:documentation>
      <bpmn:incoming>SelectMeds</bpmn:incoming>
      <bpmn:outgoing>ReturnMeds</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Finished" name="Сеанс завершён">
      <bpmn:incoming>F09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ExitGate" name="Сеанс завершён?" gatewayDirection="Diverging" default="F10" storm:LabelWidth="86" storm:LabelHeight="12">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F09" name="Да" sourceRef="ExitGate" targetRef="Finished" storm:LabelWidth="14" storm:LabelHeight="12" />
    <bpmn:serviceTask id="Denied" name="Сообщить об отказе в доступе">
      <bpmn:incoming>A05</bpmn:incoming>
      <bpmn:outgoing>A06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Role" name="Проверить сессию и роль администратора">
      <bpmn:incoming>A01</bpmn:incoming>
      <bpmn:outgoing>A02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Capture" name="Фиксировать входные данные и уточнять наблюдаемые исходы">
      <bpmn:documentation>Раздельные протоколы до начала дня и после опроса. Опросный снимок создаётся при первом сохранении опроса; далее он неизменяем. Изменения дневника и фоновые задания уточняют исходы. Неизвестное не считается отсутствием приступа; завершение горизонта учитывается отдельно.</bpmn:documentation>
      <bpmn:incoming>B03</bpmn:incoming>
      <bpmn:outgoing>B04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="CaptureStart" name="Срок фиксации или изменение данных">
      <bpmn:outgoing>B03</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CaptureStart_definition">
        <bpmn:condition>Наступил срок фиксации либо изменились данные дневника</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:endEvent id="ExportEnd" name="Выгрузка данных">
      <bpmn:incoming>B06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Export" name="Проверить согласия и подготовить исследовательскую выгрузку">
      <bpmn:documentation>Отдельный worker при его запуске. Проверка актуального согласия, прав и протокола; псевдонимизация; раздельные наборы и признаки пригодности для обучения. Старые записи истории не требуют опроса для всех видов экспорта. Экспорт не обучает модель. Отозванные согласия учитываются при следующем обновлении выгрузки.</bpmn:documentation>
      <bpmn:incoming>B05</bpmn:incoming>
      <bpmn:outgoing>B06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="ExportStart" name="При работающем экспортёре">
      <bpmn:outgoing>B05</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ExportStart_definition">
        <bpmn:timeCycle>Настраиваемое расписание</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:endEvent id="CaptureEnd" name="Результат операции">
      <bpmn:incoming>B04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="B01" sourceRef="NotifyStart" targetRef="Notify" />
    <bpmn:sequenceFlow id="B02" sourceRef="Notify" targetRef="NotifyEnd" />
    <bpmn:sequenceFlow id="B03" sourceRef="CaptureStart" targetRef="Capture" />
    <bpmn:sequenceFlow id="B04" sourceRef="Capture" targetRef="CaptureEnd" />
    <bpmn:sequenceFlow id="B06" sourceRef="Export" targetRef="ExportEnd" />
    <bpmn:sequenceFlow id="B05" sourceRef="ExportStart" targetRef="Export" />
    <bpmn:serviceTask id="Notify" name="Проверить условия и отправить погодные уведомления">
      <bpmn:documentation>Подтверждённая почта, включённые уведомления, город, порог погодного риска и отсутствие повторной отправки за день. При недоступности почты или погоды обрабатывается ошибка. Если условия не выполнены, отправка пропускается.</bpmn:documentation>
      <bpmn:incoming>B01</bpmn:incoming>
      <bpmn:outgoing>B02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="NotifyEnd" name="Результат операции">
      <bpmn:incoming>B02</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="NotifyStart" name="По расписанию">
      <bpmn:outgoing>B01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="NotifyStart_definition">
        <bpmn:timeCycle>Настраиваемое расписание</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:endEvent id="DeniedEnd" name="Результат операции">
      <bpmn:incoming>A06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Merge" name="" gatewayDirection="Converging">
      <bpmn:incoming>ReturnAttacks</bpmn:incoming>
      <bpmn:incoming>ReturnMeds</bpmn:incoming>
      <bpmn:incoming>ReturnDaily</bpmn:incoming>
      <bpmn:incoming>ReturnRisk</bpmn:incoming>
      <bpmn:incoming>ReturnStats</bpmn:incoming>
      <bpmn:incoming>ReturnProfile</bpmn:incoming>
      <bpmn:incoming>ReturnConsent</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:association id="NoteLink" sourceRef="Export" targetRef="ModelNote" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Calm">
    <bpmn:participant id="Pool" name="Calm — процессы эксплуатации" processRef="Process_Calm" />
    <bpmn:participant id="Mail" name="Почтовый сервис Коды, служебные письма, уведомления" />
    <bpmn:participant id="Weather" name="Внешние геосервисы и данные среды Open-Meteo · Nominatim · NOAA SWPC">
      <bpmn:documentation>Обобщённый внешний участник верхнего уровня. На подробной схеме разделяется на фактических поставщиков.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="MailAccess" name="Служебные письма" sourceRef="Access" targetRef="Mail" />
    <bpmn:messageFlow id="WeatherRequest" name="Запрос" sourceRef="Risk" targetRef="Weather" storm:LabelWidth="36" storm:LabelHeight="15" />
    <bpmn:messageFlow id="MailNotify" name="Уведомления" sourceRef="Notify" targetRef="Mail" />
    <bpmn:messageFlow id="Flow_0jp62rh" name="Данные среды" sourceRef="Weather" targetRef="Risk" />
    <bpmn:textAnnotation id="ModelNote">
      <bpmn:documentation>Пояснение статуса исследовательских моделей, а не исполняемая задача текущей системы.</bpmn:documentation>
      <bpmn:text>Логистическая регрессия и XGBoost:
планируемое обучение и сравнение.
В действующий расчёт не внедрены.

Выгрузка данных ≠ обучение модели.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_Calm" name="Calm · общая схема процессов">
    <bpmndi:BPMNPlane id="Plane_Calm" bpmnElement="Collaboration_Calm">
      <bpmndi:BPMNShape id="Mail_di" bpmnElement="Mail" isHorizontal="true">
        <dc:Bounds x="200" y="90" width="520" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Weather_di" bpmnElement="Weather" isHorizontal="true">
