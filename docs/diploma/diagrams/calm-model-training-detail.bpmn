      <bpmndi:BPMNShape id="shape_compare" bpmnElement="compare">
        <dc:Bounds x="1700" y="500" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_review" bpmnElement="review">
        <dc:Bounds x="1360" y="500" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_approved" bpmnElement="approved" isMarkerVisible="true">
        <dc:Bounds x="1190" y="520" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1130" y="460" width="160" height="50" />
