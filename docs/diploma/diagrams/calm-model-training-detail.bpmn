<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TrainingDetail" targetNamespace="https://calmprj.ru/bpmn" exporter="Calm diploma" exporterVersion="1">
  <bpmn:process id="Process_TrainingDetail" name="Calm — обучение модели нового приступа" isExecutable="false">
    <bpmn:startEvent id="start" name="Принято решение об обучении модели">
      <bpmn:outgoing>t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="protocol" name="Определить цель, момент прогноза и горизонт">
      <bpmn:incoming>t1</bpmn:incoming>
      <bpmn:outgoing>t2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="consent" name="Отобрать данные с действующим согласием">
      <bpmn:incoming>t2</bpmn:incoming>
      <bpmn:outgoing>t3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="snapshot" name="Подготовить своевременные снимки признаков">
      <bpmn:incoming>t3</bpmn:incoming>
      <bpmn:outgoing>t4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="outcome" name="Определить подтверждённый исход периода">
      <bpmn:incoming>t4</bpmn:incoming>
      <bpmn:outgoing>t5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="check" name="Проверить качество и пригодность примеров">
      <bpmn:incoming>t5</bpmn:incoming>
      <bpmn:outgoing>t6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="enough" name="Данных достаточно?" gatewayDirection="Diverging" default="insufficient">
      <bpmn:incoming>t6</bpmn:incoming>
      <bpmn:outgoing>sufficient</bpmn:outgoing>
      <bpmn:outgoing>insufficient</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="short" name="Обучение отложено">
      <bpmn:incoming>insufficient</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="split" name="Разделить данные по времени">
      <bpmn:incoming>sufficient</bpmn:incoming>
      <bpmn:outgoing>t7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="prepare" name="Настроить обработку признаков на обучающей части">
      <bpmn:incoming>t7</bpmn:incoming>
      <bpmn:outgoing>t8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="train" name="Обучить кандидатные модели">
      <bpmn:incoming>t8</bpmn:incoming>
      <bpmn:outgoing>t9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="assess" name="Проверить качество на отложенных данных">
      <bpmn:incoming>t9</bpmn:incoming>
      <bpmn:outgoing>t10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="compare" name="Сравнить модели с базовым прогнозом">
      <bpmn:incoming>t10</bpmn:incoming>
      <bpmn:outgoing>t11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="review" name="Оценить результаты и решить вопрос внедрения">
      <bpmn:incoming>t11</bpmn:incoming>
      <bpmn:outgoing>t12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="approved" name="Внедрение одобрено?" gatewayDirection="Diverging" default="decline">
      <bpmn:incoming>t12</bpmn:incoming>
      <bpmn:outgoing>approve</bpmn:outgoing>
      <bpmn:outgoing>decline</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="activate" name="Активировать проверенную версию модели">
      <bpmn:incoming>approve</bpmn:incoming>
      <bpmn:outgoing>t13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="deployed" name="Попытка активации завершена">
      <bpmn:incoming>t13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="keep" name="Действующая версия модели сохранена">
      <bpmn:incoming>decline</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="t1" sourceRef="start" targetRef="protocol" />
    <bpmn:sequenceFlow id="t2" sourceRef="protocol" targetRef="consent" />
    <bpmn:sequenceFlow id="t3" sourceRef="consent" targetRef="snapshot" />
    <bpmn:sequenceFlow id="t4" sourceRef="snapshot" targetRef="outcome" />
    <bpmn:sequenceFlow id="t5" sourceRef="outcome" targetRef="check" />
    <bpmn:sequenceFlow id="t6" sourceRef="check" targetRef="enough" />
    <bpmn:sequenceFlow id="sufficient" sourceRef="enough" targetRef="split" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="insufficient" sourceRef="enough" targetRef="short" name="Нет" />
    <bpmn:sequenceFlow id="t7" sourceRef="split" targetRef="prepare" />
    <bpmn:sequenceFlow id="t8" sourceRef="prepare" targetRef="train" />
    <bpmn:sequenceFlow id="t9" sourceRef="train" targetRef="assess" />
    <bpmn:sequenceFlow id="t10" sourceRef="assess" targetRef="compare" />
    <bpmn:sequenceFlow id="t11" sourceRef="compare" targetRef="review" />
    <bpmn:sequenceFlow id="t12" sourceRef="review" targetRef="approved" />
    <bpmn:sequenceFlow id="approve" sourceRef="approved" targetRef="activate" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="decline" sourceRef="approved" targetRef="keep" name="Нет" />
    <bpmn:sequenceFlow id="t13" sourceRef="activate" targetRef="deployed" />
    <bpmn:textAnnotation id="definition">
      <bpmn:text>Цель: новое начало приступа в заданном периоде. Продолжение старого приступа не равно новому началу.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_definition" sourceRef="protocol" targetRef="definition" />
    <bpmn:textAnnotation id="inputs">
      <bpmn:text>Признаки: история приступов и приёмов, доступные ответы опроса, прогноз погоды и состояние на момент прогноза.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_inputs" sourceRef="snapshot" targetRef="inputs" />
    <bpmn:textAnnotation id="labels">
      <bpmn:text>Новое начало = 1; явное подтверждение отсутствия новых начал = 0; неизвестный исход исключается из обучения.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_labels" sourceRef="outcome" targetRef="labels" />
    <bpmn:textAnnotation id="evaluation">
      <bpmn:text>Проверить качество вероятностей, калибровку, полноту и точность; сравнить с базовой частотой. Преобразования подбираются только на обучающих данных.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="assoc_evaluation" sourceRef="assess" targetRef="evaluation" />
  </bpmn:process>
  <bpmn:collaboration id="Collab_TrainingDetail">
    <bpmn:participant id="Pool_TrainingDetail" name="Calm" processRef="Process_TrainingDetail" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_TrainingDetail" name="Calm — обучение модели нового приступа">
    <bpmndi:BPMNPlane id="Plane_TrainingDetail" bpmnElement="Collab_TrainingDetail">
      <bpmndi:BPMNShape id="shape_Pool_TrainingDetail" bpmnElement="Pool_TrainingDetail" isHorizontal="true">
        <dc:Bounds x="30" y="80" width="2770" height="1050" />
      </bpmndi:BPMNShape>
