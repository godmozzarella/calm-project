        <dc:Bounds x="850" y="500" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_deployed" bpmnElement="deployed">
        <dc:Bounds x="600" y="522" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="535" y="565" width="166" height="48" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_keep" bpmnElement="keep">
        <dc:Bounds x="1192" y="742" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1127" y="785" width="166" height="48" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_definition" bpmnElement="definition">
        <dc:Bounds x="270" y="110" width="650" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_inputs" bpmnElement="inputs">
        <dc:Bounds x="850" y="815" width="660" height="105" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_labels" bpmnElement="labels">
        <dc:Bounds x="1530" y="970" width="650" height="105" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_evaluation" bpmnElement="evaluation">
        <dc:Bounds x="2090" y="825" width="590" height="105" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_t1" bpmnElement="t1">
        <di:waypoint x="136" y="318" />
        <di:waypoint x="260" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_t2" bpmnElement="t2">
        <di:waypoint x="510" y="318" />
        <di:waypoint x="580" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_t3" bpmnElement="t3">
        <di:waypoint x="830" y="318" />
        <di:waypoint x="900" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_t4" bpmnElement="t4">
        <di:waypoint x="1150" y="318" />
        <di:waypoint x="1220" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_t5" bpmnElement="t5">
        <di:waypoint x="1470" y="318" />
        <di:waypoint x="1540" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_t6" bpmnElement="t6">
        <di:waypoint x="1790" y="318" />
        <di:waypoint x="1880" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sufficient" bpmnElement="sufficient">
        <di:waypoint x="1920" y="318" />
        <di:waypoint x="2040" y="318" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1950" y="286" width="45" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_insufficient" bpmnElement="insufficient">
        <di:waypoint x="1900" y="298" />
        <di:waypoint x="1900" y="168" />
        <di:waypoint x="2030" y="168" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1930" y="140" width="45" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_t7" bpmnElement="t7">
        <di:waypoint x="2290" y="318" />
        <di:waypoint x="2380" y="318" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_t8" bpmnElement="t8">
        <di:waypoint x="2505" y="358" />
        <di:waypoint x="2505" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_t9" bpmnElement="t9">
        <di:waypoint x="2380" y="540" />
        <di:waypoint x="2290" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_t10" bpmnElement="t10">
        <di:waypoint x="2040" y="540" />
